# Vision worker settings. Copy to .env (same folder) and fill in your own keys. Never commit .env.

# Gemini API key for the books agent's matching step (Google AI Studio: https://aistudio.google.com/apikey).
# Optional: if left out, the worker uses GOOGLE_API_KEY from reference_app/.env.
GOOGLE_API_KEY=

# Google Books API key (Google Cloud console, Books API enabled): catalogue search and eBook prices.
# Without it, search falls back to Open Library and no eBook prices are looked up.
GOOGLE_BOOKS_API_KEY=

# eBay Browse API, Production keyset (developer.ebay.com): replacement and used prices.
# Without it, books are identified but left unpriced.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional. Defaults shown.
# BOOKS_MATCHER=gemini           # "rules" turns the Gemini matching step off
# BOOKS_AGENT_MODEL=gemini-3.6-flash
