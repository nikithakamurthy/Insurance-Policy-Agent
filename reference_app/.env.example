# App server (voice agent) settings. Copy to reference_app/.env and fill in your own key. Never commit .env.

# Gemini API key with access to the Live model (Google AI Studio: https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# Optional. Defaults shown.
# FNOL_GEMINI_LIVE_MODEL=gemini-3.8-live
# FNOL_VOICE=Kore
# FNOL_VISION_URL=http://127.0.0.1:4180/detect     # the vision worker
# FNOL_SWEEPS_DIR=                                  # default: sweeps/ in the repository root (the worker reads the same folder)
# FNOL_TRANSCRIPTION_VOCABULARY=                    # comma-separated words to help speech recognition
# FNOL_CORS_ORIGINS=                                # extra allowed origins, comma-separated
# USAGE_RATES_FILE=                                 # default: usage_rates.json in the repository root (rates for the cost report)
